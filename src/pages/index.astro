---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { WaitlistForm } from "../components/WaitlistForm.tsx";

const site = "https://dailyring.xyz";
const title = "DailyRing — Know your mom is okay without having to ask";
const description =
  "DailyRing makes a gentle phone call to your aging parent every day, listens for small changes, and lets you know when something deserves attention.";

// How-it-works steps. `icon` holds the inner SVG markup for a lucide icon
// (ported from lucide-react: Phone, MessageCircleHeart, Bell).
const steps = [
  {
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
    title: "Your parent gets a daily call",
    body: "DailyRing calls at the time they choose. No app, no screen, no new habit to learn.",
  },
  {
    icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M15.8 9.2a2.5 2.5 0 0 0-3.5 0l-.3.3-.35-.3a2.42 2.42 0 1 0-3.2 3.6l3.6 3.5 3.6-3.5c1.2-1.2 1.1-2.7.15-3.7"/>',
    title: "The conversation feels natural",
    body: "It gently asks about sleep, pain, meals, mood, plans, and anything unusual.",
  },
  {
    icon: '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>',
    title: "You hear about what matters",
    body: "You get a simple family dashboard and alerts when a pattern looks concerning.",
  },
];

const signs = [
  "Confusion or unusual forgetfulness",
  "Mentions of falls or near-falls",
  "Dizziness or weakness",
  "Mood changes or loneliness",
  "Missed meals or poor appetite",
  "Repeated pain or complaints",
  "Changes in sleep",
  "Unusual daily routine changes",
];
---
<Layout>
  <Fragment slot="head">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="DailyRing — A daily check-in for the people you love" />
    <meta
      property="og:description"
      content="A warm daily phone call for aging parents. You hear about what matters."
    />
    <meta property="og:url" content={site} />
    <meta property="og:site_name" content="DailyRing" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://dailyring.xyz/#organization",
      "name": "DailyRing",
      "url": "https://dailyring.xyz/"
    },
    {
      "@type": "WebSite",
      "@id": "https://dailyring.xyz/#website",
      "url": "https://dailyring.xyz/",
      "name": "DailyRing",
      "publisher": { "@id": "https://dailyring.xyz/#organization" }
    }
  ]
}
    </script>
  </Fragment>

  <div class="min-h-screen bg-background text-foreground">
    <!-- Nav -->
    <header class="sticky top-0 z-30 backdrop-blur-md bg-background/75 border-b border-border/60">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="#top" class="flex items-center gap-2">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary">
            <span class="h-2.5 w-2.5 rounded-full bg-primary"></span>
          </span>
          <span class="font-serif text-xl tracking-tight">DailyRing</span>
        </a>
        <a
          href="#waitlist"
          class="rounded-full bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-[var(--shadow-soft)] hover:opacity-95"
        >
          Join waitlist
        </a>
      </div>
    </header>

    <!-- Hero -->
    <section id="top" class="relative overflow-hidden">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:py-24 lg:grid-cols-2 lg:gap-16">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-warm-gray">
            <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
            A gentle daily check-in
          </span>
          <h1 class="mt-6 font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
            Know your mom is okay <em class="not-italic text-primary">without having to ask.</em>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-warm-gray">
            DailyRing makes a gentle phone call every day, listens for small changes, and lets you
            know when something deserves attention.
          </p>
          <div id="waitlist" class="mt-8 max-w-md">
            <WaitlistForm id="hero" client:load />
          </div>
        </div>
        <div class="relative">
          <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-accent/30 blur-2xl"></div>
          <div class="overflow-hidden rounded-[1.75rem] border border-border bg-card shadow-[var(--shadow-card)]">
            <img
              src="/hero-kitchen.jpg"
              alt="A warm kitchen table at golden hour with a phone, a small lamp, an open book and a steaming mug of tea"
              width={1536}
              height={1280}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="border-y border-border/60 bg-cream">
      <div class="mx-auto max-w-3xl px-5 py-20 md:py-28">
        <h2 class="font-serif text-3xl leading-tight tracking-tight sm:text-4xl md:text-5xl">
          &ldquo;I'm fine&rdquo; can hide a lot.
        </h2>
        <div class="mt-8 space-y-6 text-lg leading-relaxed text-warm-gray">
          <p>
            Family calls are loving, but they can become predictable. You ask how they are. They
            say they're fine. Everyone hangs up feeling okay.
          </p>
          <p>
            But aging parents often downplay pain, confusion, loneliness, poor sleep, or dizziness
            because they don't want to worry you — and they don't want to lose independence.
          </p>
          <p class="text-foreground">
            Small changes can become big problems before anyone realizes they were happening.
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-6xl px-5 py-20 md:py-28">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl tracking-tight sm:text-4xl md:text-5xl">
          A simple daily rhythm.
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {steps.map((s, i) => (
          <div
            class="group rounded-2xl border border-border bg-card p-7 shadow-[var(--shadow-soft)] transition hover:shadow-[var(--shadow-card)]"
          >
            <div class="flex items-center gap-3">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary/10 text-primary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                  set:html={s.icon}
                />
              </span>
              <span class="font-serif text-sm text-warm-gray">Step {i + 1}</span>
            </div>
            <h3 class="mt-5 font-serif text-2xl leading-snug">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-warm-gray">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Flagged -->
    <section class="bg-cream border-y border-border/60">
      <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
        <div class="max-w-2xl">
          <h2 class="font-serif text-3xl tracking-tight sm:text-4xl md:text-5xl">
            Small signs DailyRing can notice.
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-warm-gray">
            DailyRing is not trying to replace family. It helps surface the things that may not
            come up in normal calls.
          </p>
        </div>
        <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {signs.map((s) => (
            <li
              class="rounded-xl border border-border bg-card px-5 py-4 text-card-foreground shadow-[var(--shadow-soft)]"
            >
              <div class="flex items-start gap-3">
                <span class="mt-2 inline-block h-1.5 w-1.5 flex-none rounded-full bg-primary"></span>
                <span class="leading-snug">{s}</span>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 max-w-2xl text-warm-gray">
          <span class="font-medium text-foreground">You decide what deserves attention.</span>{" "}
          DailyRing simply helps you notice sooner.
        </p>
      </div>
    </section>

    <!-- Pricing -->
    <section class="mx-auto max-w-3xl px-5 py-20 md:py-28 text-center">
      <h2 class="font-serif text-3xl tracking-tight sm:text-4xl md:text-5xl">
        Built to be easy to keep.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-warm-gray">
        DailyRing is planned at{" "}
        <span class="font-medium text-foreground">$29.99/month</span>, cancel anytime.
      </p>
      <p class="mt-3 text-sm text-warm-gray">
        Less than many families spend on one takeout meal — for one more daily touchpoint with
        someone you love.
      </p>
    </section>

    <!-- Final CTA -->
    <section class="px-5 pb-24">
      <div class="mx-auto max-w-4xl overflow-hidden rounded-[2rem] border border-border bg-gradient-to-b from-card to-cream p-10 text-center shadow-[var(--shadow-card)] md:p-16">
        <h2 class="font-serif text-3xl tracking-tight sm:text-4xl md:text-5xl">
          Get early access to DailyRing.
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-warm-gray">
          Be among the first families to try a calmer way to keep an eye on aging parents who
          still live independently.
        </p>
        <div class="mx-auto mt-8 max-w-md">
          <WaitlistForm id="final" client:visible />
        </div>
        <p class="mt-4 text-sm text-warm-gray">Early access spots will open gradually.</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-border/60 bg-cream">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-3 px-5 py-10 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-2">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary/10">
            <span class="h-2 w-2 rounded-full bg-primary"></span>
          </span>
          <span class="font-serif text-lg">DailyRing</span>
        </div>
        <p class="text-sm text-warm-gray">
          Daily check-ins for independent aging parents.
        </p>
        <a href="mailto:hello@dailyring.com" class="text-sm text-warm-gray hover:text-primary">
          hello@dailyring.com
        </a>
      </div>
    </footer>
  </div>
</Layout>
